function stopLoopTP()
    loopTPActive = false
    if loopTPThread then
        pcall(function() task.cancel(loopTPThread) end)
        loopTPThread = nil
    end
    local char = P.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.PlatformStand = false end)
        end
    end
